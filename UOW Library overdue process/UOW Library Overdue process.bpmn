<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1qvbohz" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.6.1">
  <bpmn:collaboration id="Collaboration_0pskwnj">
    <bpmn:participant id="Participant_0ug1lzx" name="Customer" processRef="Process_10z7ra9" />
    <bpmn:participant id="Participant_0ij9od9" name="Library" processRef="Process_0ur16hn" />
    <bpmn:participant id="Participant_1bixoyg" name="Debt collection agency" />
    <bpmn:participant id="Participant_0f7v6y5" name="Bad payment register" />
    <bpmn:participant id="Participant_16s0j91" name="Personnel unit" />
    <bpmn:participant id="Participant_0go7d0r" name="Academic registry department" />
    <bpmn:messageFlow id="Flow_04ctxwz" sourceRef="Activity_19e3ki9" targetRef="Participant_0ug1lzx" />
    <bpmn:messageFlow id="Flow_1sfyeyg" sourceRef="Activity_0xok3xb" targetRef="Participant_0ug1lzx" />
    <bpmn:messageFlow id="Flow_0bmkzqc" sourceRef="Activity_1dapcrw" targetRef="Participant_0ug1lzx" />
    <bpmn:messageFlow id="Flow_1uy0hb0" sourceRef="Activity_16jgjc5" targetRef="Participant_0ug1lzx" />
    <bpmn:messageFlow id="Flow_1lq8n4y" sourceRef="Activity_1wadpxs" targetRef="Participant_1bixoyg" />
    <bpmn:messageFlow id="Flow_0ktcapk" sourceRef="Activity_0pt8gfi" targetRef="Participant_0go7d0r" />
    <bpmn:messageFlow id="Flow_00z5jxk" sourceRef="Activity_1uvxgum" targetRef="Participant_16s0j91" />
    <bpmn:messageFlow id="Flow_1qxk2yq" sourceRef="Activity_13k2v1t" targetRef="Participant_0f7v6y5" />
    <bpmn:messageFlow id="Flow_0ej2w0n" sourceRef="Activity_0qvyvdz" targetRef="Participant_0ug1lzx" />
    <bpmn:messageFlow id="Flow_0onnfxz" sourceRef="Activity_0aaxne4" targetRef="Participant_16s0j91" />
    <bpmn:textAnnotation id="TextAnnotation_08jzx48">
      <bpmn:text>If the customer delays more than 60 days, go to the event sub-process to force case closing.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1tldlke">
      <bpmn:text>Customer not response, a librarian escalate the case to manager</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_12txr4x">
      <bpmn:text>Applied when it is a 10% case: manager escalates the case</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1guufyq" associationDirection="None" sourceRef="Flow_1lfhwnl" targetRef="TextAnnotation_12txr4x" />
    <bpmn:textAnnotation id="TextAnnotation_0jwy6ns">
      <bpmn:text>Assumption: Book not returned: Case remains open and is either resolved by return/payment later or force-closed at 60 days from initial detection.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0at11ia" associationDirection="None" sourceRef="Flow_0ad8ivg" targetRef="TextAnnotation_0jwy6ns" />
    <bpmn:textAnnotation id="TextAnnotation_1pqblx9">
      <bpmn:text>This sub-process has no internal end; it is always terminated by one of three interrupting boundary events.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0rzvyqe">
      <bpmn:text>A delay can be recognised automatically by the existing library management system in the morning of the next day after the due date</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0u5wdc8">
      <bpmn:text>An email will be sent to the customer
automatically, requesting him/her to return or renew the book.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ir0zaj" associationDirection="None" sourceRef="Flow_04ctxwz" targetRef="TextAnnotation_0u5wdc8" />
    <bpmn:textAnnotation id="TextAnnotation_19mkavl">
      <bpmn:text>Including reminder for the 1st time and fee charged information for the delay</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0qhcks5">
      <bpmn:text>The customer returns the book any time during this period.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_07gkz0q" associationDirection="None" sourceRef="Flow_06otl3w" targetRef="TextAnnotation_0qhcks5" />
    <bpmn:textAnnotation id="TextAnnotation_1qdin4x">
      <bpmn:text>Late return penalty of $0.5 per day.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04lyzoe">
      <bpmn:text>The customer in question reports that the book has been damaged or lost any time during this period.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_113g00n" associationDirection="None" sourceRef="Flow_0iuvrel" targetRef="TextAnnotation_04lyzoe" />
    <bpmn:textAnnotation id="TextAnnotation_1wkcmwa">
      <bpmn:text>10% case: the librarian escalates the case to her manager.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1udw3k9" associationDirection="None" sourceRef="Flow_1pcvw1r" targetRef="TextAnnotation_1wkcmwa" />
    <bpmn:textAnnotation id="TextAnnotation_17rpzn7">
      <bpmn:text>The fee is calculated as the cost of the book plus the late return penalty and the administrative fee.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_08z76a0">
      <bpmn:text>Informing that the case will be escalated if the book is not
returned in the next 7 days.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0x4d8d4" associationDirection="None" sourceRef="Flow_1uy0hb0" targetRef="TextAnnotation_08z76a0" />
    <bpmn:textAnnotation id="TextAnnotation_03obhr0">
      <bpmn:text>Contacting a debt collection agency by phone to collect any
outstanding fee (after 60 days forced close).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0db0g7p" associationDirection="None" sourceRef="Flow_1lq8n4y" targetRef="TextAnnotation_03obhr0" />
    <bpmn:textAnnotation id="TextAnnotation_0o7no40">
      <bpmn:text>The manager contacts the academic registry
department to suspend the student account</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0wzbp2j" associationDirection="None" sourceRef="Flow_0ktcapk" targetRef="TextAnnotation_0o7no40" />
    <bpmn:textAnnotation id="TextAnnotation_1xjk1m4">
      <bpmn:text>The manager contacts the Personnel unit to suspend the staff payroll.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1jhsp0y" associationDirection="None" sourceRef="Flow_00z5jxk" targetRef="TextAnnotation_1xjk1m4" />
    <bpmn:textAnnotation id="TextAnnotation_0o995b7">
      <bpmn:text>The manager contacts the bad payment register through a web browser</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_030vz4t" associationDirection="None" sourceRef="Flow_1qxk2yq" targetRef="TextAnnotation_0o995b7" />
    <bpmn:textAnnotation id="TextAnnotation_0ujuqyz">
      <bpmn:text>The manager will notify the personnel
unit to lift the suspension.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0qlh29u" associationDirection="None" sourceRef="Flow_0onnfxz" targetRef="TextAnnotation_0ujuqyz" />
    <bpmn:textAnnotation id="TextAnnotation_02cgc4y">
      <bpmn:text>If there is a phone number registered, she tries to call him by phone.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1hujncz" associationDirection="None" sourceRef="Flow_0bmkzqc" targetRef="TextAnnotation_02cgc4y" />
    <bpmn:textAnnotation id="TextAnnotation_1uzqsu8">
      <bpmn:text>A librarian writes a letter telling about the delay, that customer
already has received one reminder and that he will be charged a fee for the delay</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1rjy353" associationDirection="None" sourceRef="Flow_1sfyeyg" targetRef="TextAnnotation_1uzqsu8" />
    <bpmn:textAnnotation id="TextAnnotation_1bkfcwk">
      <bpmn:text>Assumption: Book returned: Refund book cost (if previously charged). If all fees fully paid → lift suspension and close case; if not fully paid → only refund book cost, case remains open, and it is either resolved later or force-closed at 60 days from initial detection.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0lnphqw" associationDirection="None" sourceRef="Flow_0meyi03" targetRef="TextAnnotation_1bkfcwk" />
    <bpmn:association id="Association_1it6hf6" associationDirection="None" sourceRef="Activity_0xok3xb" targetRef="TextAnnotation_19mkavl" />
    <bpmn:association id="Association_0pmexng" associationDirection="None" sourceRef="Activity_1qe1bnb" targetRef="TextAnnotation_1qdin4x" />
    <bpmn:association id="Association_1uryaqq" associationDirection="None" sourceRef="Event_02w3dqi" targetRef="TextAnnotation_1tldlke" />
    <bpmn:association id="Association_128gb3a" associationDirection="None" sourceRef="Activity_1ck7jwe" targetRef="TextAnnotation_17rpzn7" />
    <bpmn:association id="Association_0tld5ih" associationDirection="None" sourceRef="Event_0xxgie7" targetRef="TextAnnotation_08jzx48" />
    <bpmn:association id="Association_0hrrh6c" associationDirection="None" sourceRef="Event_0b6nvb2" targetRef="TextAnnotation_0rzvyqe" />
  </bpmn:collaboration>
